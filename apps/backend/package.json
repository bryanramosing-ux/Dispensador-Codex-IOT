{
  "name": "@dispensador/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --require ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --runInBand --testPathIgnorePatterns firestore-emulator",
    "test:emulator": "node --experimental-vm-modules -e \"require('jest').run(['--runInBand', 'firestore-emulator'])\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
