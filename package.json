{
  "name": "dispensador-codex-iot",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.15 <25" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts/*.ts tests",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/*.integration.ts",
    "verify:assets": "node scripts/verify-assets.mjs",
    "firebase:operator": "node --env-file-if-exists=.env.local scripts/operator.ts"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "mqtt": "5.16.1",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "aedes": "^1.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
