# Configuración pública de la aplicación web de Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Solo para el emulador local. Ejemplo: http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=

# Firebase Admin (ADC). En producción se recomienda una identidad del entorno.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Necesario únicamente para guardar fotos. Copiar el nombre exacto de Storage.
FIREBASE_STORAGE_BUCKET=
# Dejar vacíos fuera de los emuladores.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
STORAGE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# Broker accesible por Internet. El monolito acepta mqtts:// o wss://.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_SITE_ID=mi-dispensador
# Ruta a un PEM si el broker usa una CA privada.
MQTT_CA_FILE=
