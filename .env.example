# Configuración pública de la aplicación web de Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin. Use la ruta absoluta a la clave JSON o una identidad del entorno (ADC).
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Broker accesible por Internet. El monolito acepta mqtts:// o wss://.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_SITE_ID=mi-dispensador
# Ruta a un PEM si el broker usa una CA privada.
MQTT_CA_FILE=
